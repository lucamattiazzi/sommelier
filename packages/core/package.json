{
  "name": "@lucamattiazzi/sommelier-core",
  "version": "0.2.0-beta.1",
  "description": "Headless agent session, policy, protocol, and tracing primitives for Sommelier",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lucamattiazzi/sommelier.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/lucamattiazzi/sommelier#readme",
  "bugs": {
    "url": "https://github.com/lucamattiazzi/sommelier/issues"
  }
}
