{
  "name": "@lucamattiazzi/sommelier-testing",
  "version": "0.2.0-beta.1",
  "description": "Virtual workbook, scripted agents, traces, and adapter contract kit for Sommelier",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "sommelier-contract": "./dist/contract-cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean --external @lucamattiazzi/sommelier-core --external @lucamattiazzi/sommelier-excel && tsup src/contract-cli.ts --format esm --dts --sourcemap --external @lucamattiazzi/sommelier-core --external @lucamattiazzi/sommelier-agent-http",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sommelier-contract": "tsx src/contract-cli.ts"
  },
  "dependencies": {
    "@lucamattiazzi/sommelier-agent-http": "workspace:^",
    "@lucamattiazzi/sommelier-core": "workspace:^",
    "@lucamattiazzi/sommelier-excel": "workspace:^",
    "commander": "15.0.0",
    "zod": "4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lucamattiazzi/sommelier.git",
    "directory": "packages/testing"
  },
  "homepage": "https://github.com/lucamattiazzi/sommelier#readme",
  "bugs": {
    "url": "https://github.com/lucamattiazzi/sommelier/issues"
  }
}
