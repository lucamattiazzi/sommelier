{
  "name": "sommelier",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm bridge:build && pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check apps/*/src apps/*/package.json apps/*/tsconfig.json apps/*/*.ts packages/*/src packages/*/package.json packages/*/tsconfig.json skills/* scripts .github *.json *.ts",
    "test": "node --test scripts/isolation.test.mjs && vitest run --coverage",
    "test:unit": "vitest run",
    "test:isolation": "node --test scripts/isolation.test.mjs",
    "test:pairing": "vitest run packages/addin-core packages/client packages/bridge packages/protocol packages/transport packages/excel apps/addin apps/server",
    "addin:dev": "pnpm --filter @lucamattiazzi/sommelier-addin dev",
    "server:dev": "pnpm bridge:build && pnpm --filter @lucamattiazzi/sommelier-server dev",
    "sommelier:build": "pnpm bridge:build && pnpm --filter @lucamattiazzi/sommelier-addin... --filter @lucamattiazzi/sommelier-server... build",
    "manifest:generate": "pnpm --filter @lucamattiazzi/sommelier-addin manifest:development",
    "manifest:production": "pnpm --filter @lucamattiazzi/sommelier-addin manifest:production",
    "manifest:check": "pnpm --filter @lucamattiazzi/sommelier-addin manifest:check",
    "smoke:packages": "node scripts/package-smoke.mjs",
    "smoke:consumer": "node scripts/external-consumer-smoke.mjs",
    "changeset": "changeset",
    "bridge:build": "node scripts/build-bridge.mjs",
    "harness:install": "node scripts/install-harness.mjs",
    "test:harness": "node --test scripts/install-harness.test.mjs",
    "test:browser": "node --test scripts/pair-browser.test.mjs",
    "agent": "node packages/bridge/dist/agent.js",
    "release:beta": "pnpm -r --filter \"./packages/**\" publish --tag beta --access public --publish-branch main"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.2",
    "@changesets/cli": "2.29.7",
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@types/office-js": "1.0.547",
    "@vitest/coverage-v8": "4.1.11",
    "tsup": "8.5.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucamattiazzi/sommelier.git"
  },
  "homepage": "https://github.com/lucamattiazzi/sommelier#readme",
  "bugs": {
    "url": "https://github.com/lucamattiazzi/sommelier/issues"
  }
}
